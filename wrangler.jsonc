{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palavra-viva",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://palavra-vivallm.com.br",
    "NEXT_PUBLIC_CONTACT_EMAIL": "contato@palavra-vivallm.com.br",
    "NEXT_PUBLIC_AMAZON_TAG": "palavraviva01-20"
  }
}
